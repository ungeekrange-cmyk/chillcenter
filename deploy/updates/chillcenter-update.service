[Unit]
Description=Verify and apply admitted Chill Center component updates
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=chillcenter-update
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=10min
# Covers bounded rescue (at most ~115s), including a degraded systemd stop.
TimeoutStopSec=150s
ExecStartPre=/usr/lib/chillcenter/chill-update --config /etc/chillcenter/updates.json recover server
ExecStartPre=/usr/lib/chillcenter/chill-update --config /etc/chillcenter/updates.json recover web
ExecStartPre=/usr/lib/chillcenter/chill-update --config /etc/chillcenter/updates.json recover themes
ExecStart=/usr/lib/chillcenter/chill-update --config /etc/chillcenter/updates.json tick
ExecStopPost=-/usr/lib/chillcenter/chill-update --config /etc/chillcenter/updates.json rescue
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chillcenter-update /var/lib/chillcenter/data/updates /var/lib/chillcenter/data/backups /run/chillcenter-update /usr/lib/chillcenter/server /usr/lib/chillcenter/web /usr/lib/chillcenter/themes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID CAP_KILL
# Preserve the already-bounded UID-drop capability across the helper exec;
# setuid(service_uid) clears it before the service-owned backup executable runs.
AmbientCapabilities=CAP_SETUID
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
SystemCallArchitectures=native
