[Unit]
Description=Chill Center household media server
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target remote-fs.target

[Service]
Type=simple
User=chillcenter
Group=chillcenter
WorkingDirectory=/usr/lib/chillcenter/server/current
UMask=0077
ExecStartPre=+/usr/lib/chillcenter/chill-update --config /etc/chillcenter/updates.json recover server
ExecStartPre=+/usr/lib/chillcenter/chill-update --config /etc/chillcenter/updates.json recover web
ExecStartPre=+/usr/lib/chillcenter/chill-update --config /etc/chillcenter/updates.json recover themes
ExecStart=/usr/lib/chillcenter/server/current/payload --config /etc/chillcenter/server.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
StateDirectory=chillcenter
StateDirectoryMode=0700
ConfigurationDirectory=chillcenter
ConfigurationDirectoryMode=0750
ReadWritePaths=/var/lib/chillcenter
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
# AF_NETLINK is needed only for getifaddrs()/Bonjour interface discovery.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
